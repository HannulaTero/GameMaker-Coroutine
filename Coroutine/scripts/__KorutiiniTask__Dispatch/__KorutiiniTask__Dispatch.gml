

/**
* Creates new active task of same prototype.
* 
* @context __KorutiiniTask
* @param {Id.Instance | Struct} _this
* @param {Struct}               _vars
* @returns {Struct.__KorutiiniTask}
*/ 
function __KorutiiniTask__Dispatch(_this=other, _vars=undefined)
{
  return prototype.Dispatch(_this, _vars); 
}