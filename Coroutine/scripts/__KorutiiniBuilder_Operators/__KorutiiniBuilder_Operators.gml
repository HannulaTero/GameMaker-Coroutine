

/**
* Returns GML operatros.
* 
*/ 
function __KorutiiniBuilder_Operators()
{
  static operators = [
    "+", "+=", 
    "-", "-=",
    "*", "*=",
    "/", "/=",
    "%", "%=",
    "=", "==",
    "<", "<=",
    ">", ">=",
    "!", "!=",
    "?",
    ":",
    "++",
    "--",
    "??",
    "div",
    "mod",
  ];
  
  return operators;
}