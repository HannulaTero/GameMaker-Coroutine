

/**
* Returns keywords for GML, which are recognized by Korutiini.
*/ 
function __KorutiiniBuilder_KeywordsGML()
{
  return {
    "IF"        : "if",
    "ELSE"      : "else",
    "SWITCH"    : "switch",
    "CASE"      : "case",
    "DEFAULT"   : "default",
    "FOR"       : "for",
    "WHILE"     : "while",
    "DO"        : "do",
    "UNTIL"     : "until",
    "REPEAT"    : "repeat",
    "CONTINUE"  : "continue",
    "BREAK"     : "break",
    "RETURN"    : "return",
    "EXIT"      : "exit",
  };
}