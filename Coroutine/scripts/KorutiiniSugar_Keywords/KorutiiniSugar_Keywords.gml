#region INFORMATION
//
/*
  
  These are all available KorutiiniSugar -keywords.
  Keywords are for used by the builder.
  
  You may change the definitions as you wish, keep the definition.
  -> This can be useful, if you have some conflicting macros.
  
*/
//
#endregion
//
//=============================================================
// 
#region MAIN HANDLE.


